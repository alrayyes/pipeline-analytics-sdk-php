<?xml version="1.0"?>
<ruleset name="pipeline-analytics-sdk-php"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">
  <description>
    Complexity, coupling and dead-parameter checks for the hand-written
    layer. naming and controversial are left out per rules/php.md -- they
    fight Symfony/PSR conventions and produce noise nobody reads.
  </description>

  <rule ref="rulesets/cleancode.xml">
    <!-- Guzzle's own API is static factories (HandlerStack::create(),
         Middleware::retry()), and ApiError::fromGenerated() is a named
         constructor. None of that is a smell to refactor away. -->
    <exclude name="StaticAccess" />
  </rule>
  <rule ref="rulesets/codesize.xml" />

  <rule ref="rulesets/design.xml">
    <!-- Client is a thin facade over six generated Api classes, which is
         what a typed SDK client's surface looks like, not excess
         coupling to trim. -->
    <exclude name="CouplingBetweenObjects" />
  </rule>
  <rule ref="rulesets/design.xml/CouplingBetweenObjects">
    <properties>
      <property name="maximum" value="15" />
    </properties>
  </rule>
</ruleset>
