{
    "name": "alrayyes/pipeline-analytics-sdk-php",
    "description": "PHP client for pipeline-analytics's REST API, generated from its OpenAPI spec with openapi-generator.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ryan Kes",
            "email": "ryan@andthensome.nl"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "8.2.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "2.53.0",
        "infection/infection": "0.29.14",
        "laravel/pint": "1.32.1",
        "pestphp/pest": "3.8.7",
        "phpmd/phpmd": "2.15.0",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.2.14",
        "phpstan/phpstan-phpunit": "2.0.18",
        "phpunit/phpunit": "11.5.56",
        "rector/rector": "2.6.7",
        "roave/security-advisories": "dev-latest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "PipelineAnalytics\\": "src/",
            "PipelineAnalytics\\Generated\\": "generated/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PipelineAnalytics\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true
    },
    "scripts": {
        "infection": "infection --threads=max",
        "normalize:fix": "composer normalize",
        "normalize:lint": "composer normalize --dry-run",
        "phpmd": "phpmd src text phpmd.xml.dist --exclude generated",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "pint:fix": "pint",
        "pint:lint": "pint --test",
        "rector:fix": "rector process",
        "rector:lint": "rector process --dry-run",
        "test": "pest",
        "test:contract": "pest --testsuite contract"
    }
}
